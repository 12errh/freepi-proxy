{
  "name": "freepi-proxy",
  "version": "1.0.0",
  "description": "Zero-dependency local proxy, dashboard, chat UI, and MCP server for the free-pi (freepi.ai) model catalog. Runs on Node.js >=22.19 or Bun, no build step.",
  "type": "module",
  "private": true,
  "bin": {
    "freepi-proxy": "./freepi-proxy"
  },
  "scripts": {
    "start": "node src/main.ts",
    "start:bun": "bun src/main.ts",
    "test": "node --test test/*.test.ts",
    "test:e2e": "FREEPI_E2E=1 node --test test/e2e.test.ts"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "free-pi",
    "openai-compatible",
    "proxy",
    "mcp",
    "llm",
    "dashboard"
  ],
  "license": "MIT"
}
